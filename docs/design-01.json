"borde": "1px solid rgba(155,170,189,0.12)",
"padding": "32px"
}
},
"efectos": {
"sombras": {
"sm": "0 2px 6px rgba(0,0,0,0.25)",
"md": "0 4px 12px rgba(0,0,0,0.35)",
"lg": "0 8px 24px rgba(0,0,0,0.45)",
"glow_cian": "0 0 24px rgba(23,168,229,0.25)"
},
"borderRadius": {
"sm": "6px",
"md": "10px",
"lg": "14px",
"xl": "20px",
"circular": "50%"
},
"hover": {
"tarjeta": {
"transform": "translateY(-4px)",
"transition": "all 250ms ease-out",
"sombra": "0 8px 24px rgba(23,168,229,0.15)",
"borde": "rgba(23,168,229,0.4)"
},
"boton": {
"transform": "scale(1.02)",
"transition": "all 200ms ease"
},
"enlace": {
"color": "#54D6FF",
"transition": "color 200ms ease"
}
},
"gradientes": {
"fondo_hero_imagen": "radial-gradient(circle at center, rgba(23,168,229,0.15) 0%, rgba(8,17,31,0) 70%)",
"linea_nav_activa": "linear-gradient(90deg, #17A8E5, #54D6FF)"
}
},
